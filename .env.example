# Copy this file to .env and fill in the values. Never commit .env.

# Local Postgres from docker-compose.yml. On Railway this is set automatically.
DATABASE_URL="postgresql://redlantern:redlantern@localhost:5432/redlantern_dev"
# Used by `npm run test:db` only.
TEST_DATABASE_URL="postgresql://redlantern:redlantern@localhost:5432/redlantern_test"

# Public address of the site, used in emails and the sitemap.
SITE_URL="http://localhost:3000"

# Booking emails. Without a key, emails are printed in the terminal instead of sent.
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=""
# Sender for booking emails, on a domain verified in Resend, e.g. "Red Lantern Bikes <bookings@example.com>".
EMAIL_FROM=""
# Where new enquiries (tours, contact form) are sent. Leave empty to only see them in the staff area.
ENQUIRIES_EMAIL=""
# Where booking requests are sent, with their Accept and Decline links. Whoever
# reads this inbox can answer requests, so use the owner's own address.
# Leave empty to use ENQUIRIES_EMAIL.
BOOKINGS_EMAIL=""
# Random secret for signing staff login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Visitor stats with Umami (cookie-free). Leave empty to turn off.
# Website ID from https://cloud.umami.is (Settings, Websites).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# Only count visits on these domains, comma-separated, e.g. "redlanternbikes.com,www.redlanternbikes.com".
NEXT_PUBLIC_UMAMI_DOMAINS=""
# Only if you host Umami yourself; otherwise leave empty.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""

# Error alerts with Sentry. Leave empty to turn off. The same DSN in both,
# from https://sentry.io (Project settings, Client Keys).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# e.g. "production" or "staging", to tell reports apart.
SENTRY_ENVIRONMENT=""

# Google reviews on the home and bike pages (Places API). Leave empty to use
# src/content/reviews.json instead, or to hide reviews. Key from Google Cloud
# (APIs & Services, Credentials; enable "Places API (New)"), restricted to
# that API. Place ID from https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# Archive of finished rentals in Notion (the "Archive" button on a staff booking page).
# Create an internal integration at https://www.notion.so/profile/integrations, copy its
# secret here, and give it access to the RENTALS page (page menu, Connections).
NOTION_TOKEN=""
# The RENTALS page's ID: the 32 characters at the end of its link.
NOTION_RENTALS_PAGE_ID=""
