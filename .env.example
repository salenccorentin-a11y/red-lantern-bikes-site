# Copy this file to .env and fill in the values. Never commit .env.

# Local Postgres from docker-compose.yml. On Railway this is set automatically.
DATABASE_URL="postgresql://redlantern:redlantern@localhost:5432/redlantern_dev"
# Used by `npm run test:db` only.
TEST_DATABASE_URL="postgresql://redlantern:redlantern@localhost:5432/redlantern_test"

# Public address of the site, used in emails and the sitemap.
SITE_URL="http://localhost:3000"

# Booking emails. Without a key, emails are printed in the terminal instead of sent.
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=""
# Sender for booking emails, on a domain verified in Resend, e.g. "Red Lantern Bikes <bookings@example.com>".
EMAIL_FROM=""
# Where new enquiries (tours, contact form) are sent. Leave empty to only see them in the staff area.
ENQUIRIES_EMAIL=""
# Random secret for signing staff login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
